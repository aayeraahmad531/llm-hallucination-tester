# OpenAI API key (grab yours from https://platform.openai.com)
OPENAI_API_KEY=your_openai_api_key_here

# Default model used for the pipeline steps if not specified in request
MODEL_NAME=gpt-4o-mini

# Max questions allowed per request to protect your rate limits/credits
MAX_QUESTIONS=10

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
